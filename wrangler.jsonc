{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ryantaylor-photos",
  "compatibility_date": "2026-08-18",
  // After adding the custom domain in the dashboard once, you can manage it here instead:
  // "routes": [{ "pattern": "ryantaylor.photos", "custom_domain": true }],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Every request must reach the Worker first: /utils/api/* is API-only
    // (no matching asset anyway), and password-protected galleries need the
    // Worker to decide, per-request, whether to serve the real page or a
    // lock screen — see worker/gallery-auth.ts.
    "run_worker_first": true
  },
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["bookings@ryantaylor.photos"] }
  ]
}
