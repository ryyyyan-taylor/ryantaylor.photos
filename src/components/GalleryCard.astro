---
import Photo from './Photo.astro';
import { photoById, type Gallery } from '../lib/photos';

interface Props {
  gallery: Gallery;
  eager?: boolean;
}

const { gallery, eager = false } = Astro.props;
const cover = photoById(gallery.cover) ?? gallery.photos[0];
---

<a class="gallery-card" href={`/${gallery.slug}/`}>
  <figure>
    <div class="frame">
      <Photo photo={cover} sizes="(min-width: 60rem) 30vw, 92vw" loading={eager ? 'eager' : 'lazy'} />
    </div>
    <figcaption>
      <span class="title-row">
        <h2>{gallery.title}</h2>
        <span class="count">{gallery.photos.length} photographs</span>
      </span>
    </figcaption>
  </figure>
</a>
