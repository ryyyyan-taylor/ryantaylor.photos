---
import { largestSrc, sizedSrc, videoSrc, type Photo } from '../lib/photos';

interface Props {
  galleries: { slug: string; photos: Photo[] }[];
}

const { galleries } = Astro.props;

const toItem = (photo: Photo, gallerySlug: string) => ({
  kind: photo.kind,
  galleryHref: `/${gallerySlug}/`,
  alt: photo.alt,
  caption: photo.caption,
  note: photo.note ?? '',
  // For photos this is the full-size image; for videos it's the poster
  // frame used as <video poster> and while the thumbnail strip is idle.
  poster: largestSrc(photo),
  thumb: sizedSrc(photo, photo.widths[0]),
  video: photo.kind === 'video' ? videoSrc(photo) : null,
  width: photo.width,
  height: photo.height,
  duration: photo.duration ?? null,
  fps: photo.videoMeta?.fps ?? null,
  exif: photo.exif ?? null,
  downloads:
    photo.kind === 'video'
      ? photo.videoSources
        ? [{ url: videoSrc(photo), label: 'Original video' }]
        : []
      : photo.widths.map((w) => ({
          url: sizedSrc(photo, w),
          width: w,
          height: Math.round((w / photo.width) * photo.height),
        })),
});

const groups = Object.fromEntries(galleries.map(({ slug, photos }) => [slug, photos.map((photo) => toItem(photo, slug))]));
---

<dialog class="lightbox" id="lightbox" aria-label="Photo viewer">
  <button class="close" type="button" data-action="close" aria-label="Close">✕</button>
  <div class="lightbox-layout">
    <div class="lightbox-stage">
      <div class="lightbox-image-wrap">
        <button class="lightbox-nav prev" type="button" data-action="prev" aria-label="Previous photo">‹</button>
        <img id="lightbox-image" alt="" draggable="false" />
        <video id="lightbox-video" playsinline controls hidden></video>
        <button class="lightbox-nav next" type="button" data-action="next" aria-label="Next photo">›</button>
      </div>
      <div class="lightbox-thumbs" id="lightbox-thumbs"></div>
    </div>
    <aside class="lightbox-sidebar">
      <p class="lightbox-caption" id="lightbox-caption"></p>
      <dl class="lightbox-exif" id="lightbox-exif"></dl>
      <p class="lightbox-note" id="lightbox-note"></p>
      <div class="lightbox-download">
        <button class="download-toggle" type="button" data-action="download-toggle" aria-expanded="false" aria-controls="download-menu">
          Download
        </button>
        <ul class="download-menu" id="download-menu" hidden></ul>
      </div>
      <a class="view-gallery-link" id="lightbox-gallery-link" href="/">View Full Gallery</a>
    </aside>
  </div>
</dialog>

<script type="application/json" id="lightbox-data" set:html={JSON.stringify(groups)} />

<script>
  interface DownloadOption {
    url: string;
    width?: number;
    height?: number;
    label?: string;
  }
  interface PhotoExif {
    camera: string | null;
    lens: string | null;
    focalLength: string | null;
    aperture: string | null;
    shutterSpeed: string | null;
    iso: number | null;
    takenAt: string | null;
  }
  interface LightboxItem {
    kind: 'photo' | 'video';
    galleryHref: string;
    alt: string;
    caption: string;
    note: string;
    poster: string;
    thumb: string;
    video: string | null;
    width: number;
    height: number;
    duration: number | null;
    fps: number | null;
    exif: PhotoExif | null;
    downloads: DownloadOption[];
  }

  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const imageWrap = document.querySelector('.lightbox-image-wrap') as HTMLDivElement;
  const image = document.getElementById('lightbox-image') as HTMLImageElement;
  const video = document.getElementById('lightbox-video') as HTMLVideoElement;
  const caption = document.getElementById('lightbox-caption') as HTMLParagraphElement;
  const exifList = document.getElementById('lightbox-exif') as HTMLDListElement;
  const note = document.getElementById('lightbox-note') as HTMLParagraphElement;
  const thumbs = document.getElementById('lightbox-thumbs') as HTMLDivElement;
  const downloadToggle = document.getElementById('lightbox')!.querySelector<HTMLButtonElement>('.download-toggle')!;
  const downloadMenu = document.getElementById('download-menu') as HTMLUListElement;
  const galleryLink = document.getElementById('lightbox-gallery-link') as HTMLAnchorElement;
  const tiles = [...document.querySelectorAll<HTMLButtonElement>('.tile')];
  const dataEl = document.getElementById('lightbox-data');
  const groups: Record<string, LightboxItem[]> = dataEl ? JSON.parse(dataEl.textContent ?? '{}') : {};
  let activeGallery = '';
  let items: LightboxItem[] = [];
  let thumbButtons: HTMLButtonElement[] = [];
  let index = 0;

  const exifLabels: Record<keyof NonNullable<LightboxItem['exif']>, string> = {
    camera: 'Camera',
    lens: 'Lens',
    focalLength: 'Focal length',
    aperture: 'Aperture',
    shutterSpeed: 'Shutter',
    iso: 'ISO',
    takenAt: 'Taken',
  };

  const bindThumbs = () => {
    thumbs.innerHTML = items
      .map(
        (item, i) =>
          `<button class="lightbox-thumb${item.kind === 'video' ? ' is-video' : ''}" type="button" data-index="${i}" aria-label="View photo ${i + 1}"><img src="${item.thumb}" alt="" loading="lazy" /></button>`,
      )
      .join('');
    thumbButtons = [...thumbs.querySelectorAll<HTMLButtonElement>('.lightbox-thumb')];
    thumbButtons.forEach((btn, i) => btn.addEventListener('click', () => show(i)));
  };

  const loadGallery = (slug: string) => {
    if (slug === activeGallery) return;
    activeGallery = slug;
    items = groups[slug] ?? [];
    bindThumbs();
  };

  const renderExif = (exif: LightboxItem['exif']) => {
    exifList.innerHTML = '';
    if (exif) {
      for (const key of Object.keys(exifLabels) as (keyof typeof exifLabels)[]) {
        const value = exif[key];
        if (!value) continue;
        exifList.insertAdjacentHTML(
          'beforeend',
          `<div class="exif-row"><dt>${exifLabels[key]}</dt><dd>${key === 'iso' ? `ISO ${value}` : value}</dd></div>`,
        );
      }
    }
    exifList.hidden = !exifList.children.length;
  };

  const formatDuration = (seconds: number) => {
    const total = Math.max(0, Math.round(seconds));
    const m = Math.floor(total / 60);
    const s = total % 60;
    return `${m}:${String(s).padStart(2, '0')}`;
  };

  const renderVideoInfo = (item: LightboxItem) => {
    exifList.innerHTML = '';
    const rows: [string, string][] = [];
    if (item.duration != null) rows.push(['Duration', formatDuration(item.duration)]);
    rows.push(['Resolution', `${item.width} × ${item.height}`]);
    if (item.fps) rows.push(['Frame rate', `${item.fps} fps`]);
    for (const [label, value] of rows) {
      exifList.insertAdjacentHTML('beforeend', `<div class="exif-row"><dt>${label}</dt><dd>${value}</dd></div>`);
    }
    exifList.hidden = !exifList.children.length;
  };

  const renderDownloads = (downloads: DownloadOption[]) => {
    downloadMenu.innerHTML = downloads
      .map(
        (d) =>
          `<li><a href="${d.url}" download target="_blank" rel="noopener">${d.label ?? `${d.width} × ${d.height}`}</a></li>`,
      )
      .join('');
  };

  const closeDownloadMenu = () => {
    downloadMenu.hidden = true;
    downloadToggle.setAttribute('aria-expanded', 'false');
  };

  const MIN_ZOOM = 1;
  const MAX_ZOOM = 4;
  let zoom = MIN_ZOOM;
  let panX = 0;
  let panY = 0;

  const clamp = (value: number, max: number) => Math.min(max, Math.max(-max, value));

  // transform-origin stays centered; panning/zoom-toward-cursor both work by
  // solving for a translate (in screen px, applied after the scale) rather
  // than moving the origin — offsetWidth/offsetHeight are the CSS layout
  // box, unaffected by our own transform, so they're a stable base size to
  // clamp against regardless of current zoom.
  const applyTransform = () => {
    if (zoom > MIN_ZOOM) {
      const maxPanX = Math.max(0, (image.offsetWidth * zoom - imageWrap.clientWidth) / 2);
      const maxPanY = Math.max(0, (image.offsetHeight * zoom - imageWrap.clientHeight) / 2);
      panX = clamp(panX, maxPanX);
      panY = clamp(panY, maxPanY);
      image.style.transform = `translate(${panX}px, ${panY}px) scale(${zoom})`;
    } else {
      panX = 0;
      panY = 0;
      image.style.transform = '';
    }
    image.classList.toggle('is-zoomed', zoom > MIN_ZOOM);
  };

  const resetZoom = () => {
    zoom = MIN_ZOOM;
    applyTransform();
  };

  imageWrap.addEventListener(
    'wheel',
    (event) => {
      if (items[index]?.kind === 'video') return;
      event.preventDefault();
      const rect = image.getBoundingClientRect();
      const offsetX = event.clientX - (rect.left + rect.width / 2);
      const offsetY = event.clientY - (rect.top + rect.height / 2);
      const factor = Math.exp(-event.deltaY * 0.0015);
      const nextZoom = Math.min(MAX_ZOOM, Math.max(MIN_ZOOM, zoom * factor));
      const ratio = nextZoom / zoom;
      panX += offsetX * (1 - ratio);
      panY += offsetY * (1 - ratio);
      zoom = nextZoom;
      applyTransform();
    },
    { passive: false },
  );

  let dragging = false;
  let dragStartX = 0;
  let dragStartY = 0;
  let panStartX = 0;
  let panStartY = 0;

  image.addEventListener('pointerdown', (event) => {
    if (zoom === MIN_ZOOM || items[index]?.kind === 'video') return;
    dragging = true;
    dragStartX = event.clientX;
    dragStartY = event.clientY;
    panStartX = panX;
    panStartY = panY;
    image.setPointerCapture(event.pointerId);
    image.classList.add('is-dragging');
  });

  image.addEventListener('pointermove', (event) => {
    if (!dragging) return;
    panX = panStartX + (event.clientX - dragStartX);
    panY = panStartY + (event.clientY - dragStartY);
    applyTransform();
  });

  const endDrag = (event: PointerEvent) => {
    if (!dragging) return;
    dragging = false;
    image.classList.remove('is-dragging');
    image.releasePointerCapture(event.pointerId);
  };
  image.addEventListener('pointerup', endDrag);
  image.addEventListener('pointercancel', endDrag);

  // Backgrounded video that just gets paused keeps its buffered mp4 alive —
  // clearing src and calling load() actually detaches it.
  const stopVideo = () => {
    if (video.hidden) return;
    video.pause();
    video.removeAttribute('src');
    video.load();
  };

  const show = (next: number) => {
    index = (next + items.length) % items.length;
    const item = items[index];
    stopVideo();
    resetZoom();

    if (item.kind === 'video' && item.video) {
      image.hidden = true;
      video.hidden = false;
      video.poster = item.poster;
      video.src = item.video;
      video.muted = true;
      video.play().catch(() => {});
    } else {
      video.hidden = true;
      image.hidden = false;
      image.src = item.poster;
    }
    image.alt = item.alt;

    caption.textContent = item.caption;
    if (item.kind === 'video') renderVideoInfo(item);
    else renderExif(item.exif);
    note.textContent = item.note;
    note.hidden = !item.note;
    renderDownloads(item.downloads);
    closeDownloadMenu();
    galleryLink.href = item.galleryHref;
    thumbButtons.forEach((btn, i) => {
      btn.classList.toggle('active', i === index);
      if (i === index) btn.scrollIntoView({ block: 'nearest', inline: 'center' });
    });
    items.forEach((neighbor, i) => {
      if (Math.abs(i - index) !== 1) return;
      new Image().src = neighbor.poster;
    });
  };

  tiles.forEach((tile) =>
    tile.addEventListener('click', () => {
      const slug = tile.dataset.gallery;
      const tileIndex = Number(tile.dataset.index);
      if (!slug || Number.isNaN(tileIndex)) return;
      loadGallery(slug);
      show(tileIndex);
      dialog.showModal();
      document.documentElement.classList.add('no-scroll');
    }),
  );

  dialog.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const action = target.closest('[data-action]')?.getAttribute('data-action');
    if (action === 'next') show(index + 1);
    else if (action === 'prev') show(index - 1);
    else if (action === 'close') dialog.close();
    else if (action === 'download-toggle') {
      const expanded = downloadToggle.getAttribute('aria-expanded') === 'true';
      downloadMenu.hidden = expanded;
      downloadToggle.setAttribute('aria-expanded', String(!expanded));
    } else if (!target.closest('.lightbox-download') && !downloadMenu.hidden) {
      closeDownloadMenu();
    }
    if (event.target === dialog) dialog.close();
  });

  dialog.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowRight') show(index + 1);
    if (event.key === 'ArrowLeft') show(index - 1);
    if (event.key === 'Escape') closeDownloadMenu();
  });

  dialog.addEventListener('close', () => {
    stopVideo();
    const slug = activeGallery;
    const viewedIndex = index;
    // Deferred: the browser's own dialog-close focus restoration runs after
    // this event handler and would otherwise clobber our target.
    requestAnimationFrame(() => {
      if (slug) {
        document.querySelector<HTMLElement>(`.tile[data-gallery="${slug}"][data-index="${viewedIndex}"]`)?.focus();
      }
    });
    document.documentElement.classList.remove('no-scroll');
  });
</script>
