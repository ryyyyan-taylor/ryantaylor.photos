---
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import Lightbox from '../components/Lightbox.astro';
import { describeMedia, formatBytes, galleries, ogImage, photoById, zipHref, type Gallery } from '../lib/photos';

export function getStaticPaths() {
  const pages = galleries.map((gallery) => ({ params: { gallery: gallery.slug }, props: { gallery, locked: false } }));

  // Every password-protected gallery also gets a `__locked` sibling route —
  // the same page, rendered with only blur-up placeholders and no real
  // photo/zip URLs anywhere in it (no <Lightbox/>, dead download hrefs).
  // worker/gallery-auth.ts serves this instead of the real page (as a 401)
  // until the password cookie checks out — see that file and Base.astro's
  // `locked`/`overlay` slot for how the two halves fit together. `__locked`
  // can't collide with a real slug: slugify() never produces underscores.
  const lockedPages = galleries
    .filter((gallery) => gallery.passwordHash)
    .map((gallery) => ({ params: { gallery: `${gallery.slug}/__locked` }, props: { gallery, locked: true } }));

  return [...pages, ...lockedPages];
}

const { gallery, locked } = Astro.props as { gallery: Gallery; locked: boolean };
const coverPhoto = photoById(gallery.cover);
const availableUntil = gallery.availableUntil
  ? new Date(`${gallery.availableUntil}T00:00:00Z`).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    })
  : null;
---

<Base
  title={gallery.title}
  description={gallery.description || `${gallery.title} — photography by Ryan Taylor.`}
  image={locked ? undefined : coverPhoto ? ogImage(coverPhoto) : undefined}
  noindex={locked || gallery.unlisted}
  locked={locked}
>
  <section class="page-head">
    <p class="eyebrow">
      <a class="back-link" href="/" aria-label="Back to all work">
        ←
      </a>
      {describeMedia(gallery.photos)}
    </p>
    <h1>{gallery.title}</h1>
    {gallery.description && <p class="lede">{gallery.description}</p>}
    {availableUntil && <p class="availability-note">This gallery is available to view through {availableUntil}.</p>}
    {
      gallery.zips && (
        <div class="gallery-actions">
          <details class="zip-download">
            <summary>Download all</summary>
            <ul>
              {gallery.zips.map((zip) => (
                <li>
                  <a href={locked ? '#' : zipHref(zip)} download={!locked}>
                    {zip.label} ({formatBytes(zip.size)})
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </div>
      )
    }
  </section>

  <div class="masonry">
    {
      gallery.photos.map((photo, i) => (
        <Tile
          photo={photo}
          gallerySlug={gallery.slug}
          indexInGallery={i}
          sizes="(min-width: 68rem) 32vw, (min-width: 40rem) 48vw, 94vw"
          loading={i < 4 ? 'eager' : 'lazy'}
          placeholder={locked}
        />
      ))
    }
  </div>

  {!locked && <Lightbox galleries={[{ slug: gallery.slug, photos: gallery.photos }]} />}

  {
    locked && (
      <Fragment slot="overlay">
        <div class="lock-scrim" id="lock-scrim">
          <div class="lock-card">
            <h1>{gallery.title}</h1>
            <p>This gallery is password protected.</p>
            <form id="lock-form" method="post" action="/api/gallery-auth">
              <input type="hidden" name="slug" value={gallery.slug} />
              <input type="password" name="password" placeholder="Password" required autofocus />
              <p class="lock-error" id="lock-error" hidden>
                Wrong password — try again.
              </p>
              <button class="btn" type="submit">
                View gallery
              </button>
            </form>
          </div>
        </div>
        <script>
          // Progressive enhancement: without JS the form still works via a
          // normal POST + redirect (see worker/index.ts handleGalleryAuth),
          // landing back here with ?e=1 read below. With JS, submit in
          // place so a correct password can fade the scrim out instead of
          // round-tripping through a full navigation to get back here.
          const form = document.getElementById('lock-form') as HTMLFormElement;
          const scrim = document.getElementById('lock-scrim') as HTMLDivElement;
          const errorEl = document.getElementById('lock-error') as HTMLParagraphElement;
          const button = form.querySelector('button') as HTMLButtonElement;

          if (new URLSearchParams(location.search).get('e') === '1') errorEl.hidden = false;

          form.addEventListener('submit', async (event) => {
            event.preventDefault();
            button.disabled = true;
            errorEl.hidden = true;

            try {
              const response = await fetch('/api/gallery-auth', { method: 'POST', body: new FormData(form) });
              if (response.ok) {
                scrim.classList.add('is-dismissing');
                setTimeout(() => location.reload(), 350);
              } else {
                errorEl.hidden = false;
                button.disabled = false;
              }
            } catch {
              errorEl.hidden = false;
              button.disabled = false;
            }
          });
        </script>
      </Fragment>
    )
  }
</Base>
