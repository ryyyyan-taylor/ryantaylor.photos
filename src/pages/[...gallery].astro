---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Lightbox from '../components/Lightbox.astro';
import { galleries, sections, type Gallery } from '../lib/photos';

export function getStaticPaths() {
  return galleries.map((gallery) => ({ params: { gallery: gallery.slug }, props: { gallery } }));
}

const { gallery } = Astro.props as { gallery: Gallery };
const section = sections.find((s) => s.slug === gallery.section);
---

<Base title={gallery.title} description={gallery.description}>
  <section class="page-head">
    <p class="eyebrow">
      {
        section ? (
          <a href={`/sections/${section.slug}/`}>{section.title}</a>
        ) : (
          <a href="/">Work</a>
        )
      }
      {' / '}{gallery.photos.length} photographs
    </p>
    <h1>{gallery.title}</h1>
    {gallery.description && <p class="lede">{gallery.description}</p>}
  </section>

  <div class="masonry">
    {
      gallery.photos.map((photo, i) => (
        <button class="tile" type="button" aria-label={photo.alt || `View photo ${i + 1}`}>
          <Photo photo={photo} sizes="(min-width: 68rem) 32vw, (min-width: 40rem) 48vw, 94vw" loading={i < 4 ? 'eager' : 'lazy'} />
        </button>
      ))
    }
  </div>

  <Lightbox />
</Base>
