---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Lightbox from '../components/Lightbox.astro';
import { galleries, ogImage, photoById, type Gallery } from '../lib/photos';

export function getStaticPaths() {
  return galleries.map((gallery) => ({ params: { gallery: gallery.slug }, props: { gallery } }));
}

const { gallery } = Astro.props as { gallery: Gallery };
const coverPhoto = photoById(gallery.cover);
---

<Base
  title={gallery.title}
  description={gallery.description || `${gallery.title} — photography by Ryan Taylor.`}
  image={coverPhoto ? ogImage(coverPhoto) : undefined}
>
  <section class="page-head">
    <p class="eyebrow">
      <a class="back-link" href="/" aria-label="Back to all work">
        ←
      </a>
      {gallery.photos.length} photographs
    </p>
    <h1>{gallery.title}</h1>
    {gallery.description && <p class="lede">{gallery.description}</p>}
  </section>

  <div class="masonry">
    {
      gallery.photos.map((photo, i) => (
        <button class="tile" type="button" data-gallery={gallery.slug} data-index={i} aria-label={photo.alt || `View photo ${i + 1}`}>
          <Photo photo={photo} sizes="(min-width: 68rem) 32vw, (min-width: 40rem) 48vw, 94vw" loading={i < 4 ? 'eager' : 'lazy'} />
        </button>
      ))
    }
  </div>

  <Lightbox galleries={[{ slug: gallery.slug, photos: gallery.photos }]} />
</Base>
