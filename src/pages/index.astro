---
import Base from '../layouts/Base.astro';
import GalleryCard from '../components/GalleryCard.astro';
import SectionFilter from '../components/SectionFilter.astro';
import { galleries, sections, unsectioned } from '../lib/photos';

const groups = [...sections, ...(unsectioned.length ? [{ slug: 'other', title: 'Other', galleries: unsectioned }] : [])];
---

<Base heroReveal>
  <section class="page-head">
    <h1 id="hero-name">Ryan Taylor</h1>
    <p class="lede">
      Hobbyist photographer in Denver, CO. Want to work together? Feel free to reach out!
    </p>
  </section>

  {
    galleries.length === 0 ? (
      <div class="empty">
        <p>No photos yet.</p>
        <p>
          Drop images into <code>photos/&lt;gallery-name&gt;/</code>, then run <code>npm run photos:sync</code>.
        </p>
      </div>
    ) : (
      <>
        <SectionFilter />

        {groups.map((group, g) => (
          <section class="section-group">
            <h2 class="section-heading">
              {group.slug === 'other' ? group.title : <a href={`/sections/${group.slug}/`}>{group.title}</a>}
            </h2>
            <div class="gallery-index">
              {group.galleries.map((gallery, i) => (
                <GalleryCard gallery={gallery} eager={g === 0 && i < 2} />
              ))}
            </div>
          </section>
        ))}
      </>
    )
  }
</Base>
