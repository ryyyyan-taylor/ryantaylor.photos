---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { showcases } from '../lib/showcases';
import { getGallery, headshot, ogImage, photoById, type Gallery, type Photo as PhotoType } from '../lib/photos';

const MAX_FEATURED = 3;

function featuredPhotos(gallery: Gallery | undefined): PhotoType[] {
  if (!gallery) return [];
  const picked = (gallery.featured ?? []).map(photoById).filter((p): p is PhotoType => !!p);
  if (picked.length) return picked.slice(0, MAX_FEATURED);
  const stills = gallery.photos.filter((p) => p.kind === 'photo');
  const cover = stills.find((p) => p.id === gallery.cover);
  return (cover ? [cover, ...stills.filter((p) => p !== cover)] : stills).slice(0, MAX_FEATURED);
}

const blocks = showcases.map((item) => ({ ...item, photos: featuredPhotos(getGallery(item.slug)) }));

const coverPhoto = blocks.find((b) => b.photos.length)?.photos[0];
---

<Base
  heroReveal
  description="Ryan Taylor is a photographer based in Denver, CO, shooting events and sports."
  image={coverPhoto ? ogImage(coverPhoto) : undefined}
>
  <section class="hero">
    {
      headshot ? (
        <div class="hero-portrait">
          <Photo photo={headshot} sizes="16rem" loading="eager" />
        </div>
      ) : (
        <div class="hero-portrait" role="img" aria-label="Portrait of Ryan Taylor">
          <span>Portrait coming soon</span>
        </div>
      )
    }
    <div class="hero-copy">
      <p class="eyebrow">Photographer · Denver, CO</p>
      <h1 id="hero-name">Ryan Taylor</h1>
      <p class="lede">
        Hi there, I'm an independent photographer working around Denver! I love to explore all areas of photography, from events and sports to macro and product shooting!
      </p>
    </div>
  </section>

  {
    blocks.map((block, i) => (
      <section class:list={['feature', { 'feature--flip': i % 2 === 1 }]} aria-labelledby={`feature-${block.slug}`}>
        <div class="feature-copy">
          <h2 id={`feature-${block.slug}`}>{block.title}</h2>
          <p class="lede">{block.blurb}</p>
          <a class="cta-link" href={`/${block.slug}/`}>
            Learn more
          </a>
        </div>
        <div class="feature-photos" data-count={block.photos.length || MAX_FEATURED}>
          {block.photos.length
            ? block.photos.map((photo, j) => (
                <Photo photo={photo} sizes={j === 0 ? '(min-width: 48rem) 23rem, 92vw' : '(min-width: 48rem) 11rem, 46vw'} />
              ))
            : Array.from({ length: MAX_FEATURED }, () => <div class="feature-photos-empty" />)}
        </div>
      </section>
    ))
  }

  <section class="archive-cta" aria-labelledby="archive-cta-title">
    <h2 id="archive-cta-title">Archive</h2>
    <p class="lede">Looking for a specific shot or just want to see all my old work? Check it out here.</p>
    <a class="cta-link" href="/archive/">
      Browse the archive
    </a>
  </section>
</Base>
