---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Lightbox from '../components/Lightbox.astro';
import SectionFilter from '../components/SectionFilter.astro';
import { galleries, ogImage, photoById, type Gallery, type Photo as PhotoType } from '../lib/photos';

const coverPhoto = galleries[0] ? photoById(galleries[0].cover) : undefined;

interface Tile {
  photo: PhotoType;
  gallerySlug: string;
  indexInGallery: number;
}

// Build a fresh array of wrapper objects and shuffle that — never shuffle
// `galleries` or any gallery's `.photos` in place, they're module-level
// singletons shared by every page in this build.
const tiles: Tile[] = galleries.flatMap((gallery: Gallery) =>
  gallery.photos.map((photo, indexInGallery) => ({ photo, gallerySlug: gallery.slug, indexInGallery })),
);

// Fisher-Yates. Frontmatter runs once at build time, so this order is baked
// into the emitted HTML and stays fixed until the next build/deploy.
for (let i = tiles.length - 1; i > 0; i--) {
  const j = Math.floor(Math.random() * (i + 1));
  [tiles[i], tiles[j]] = [tiles[j], tiles[i]];
}
---

<Base
  heroReveal
  description="Hobbyist photography by Ryan Taylor, based in Denver, CO — sports and outdoor work."
  image={coverPhoto ? ogImage(coverPhoto) : undefined}
>
  <section class="page-head">
    <h1 id="hero-name">Ryan Taylor</h1>
    <p class="lede">
      Hobbyist photographer in Denver, CO. Want to work together? Feel free to reach out!
    </p>
  </section>

  {
    galleries.length === 0 ? (
      <div class="empty">
        <p>No photos yet.</p>
        <p>
          Drop images into <code>photos/&lt;gallery-name&gt;/</code>, then run <code>npm run photos:sync</code>.
        </p>
      </div>
    ) : (
      <>
        <SectionFilter />

        <div class="masonry">
          {
            tiles.map(({ photo, gallerySlug, indexInGallery }, i) => (
              <button
                class="tile"
                type="button"
                data-gallery={gallerySlug}
                data-index={indexInGallery}
                aria-label={photo.alt || `View photo ${i + 1}`}
              >
                <Photo photo={photo} sizes="(min-width: 68rem) 32vw, (min-width: 40rem) 48vw, 94vw" loading={i < 4 ? 'eager' : 'lazy'} />
              </button>
            ))
          }
        </div>

        <Lightbox galleries={galleries.map((gallery: Gallery) => ({ slug: gallery.slug, photos: gallery.photos }))} />
      </>
    )
  }
</Base>
