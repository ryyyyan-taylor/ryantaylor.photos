---
import '../styles/global.css';
import { IMG_BASE, listedGalleries, photoById, ogImage } from '../lib/photos';

interface Props {
  title?: string;
  description?: string;
  heroReveal?: boolean;
  image?: { url: string; width: number; height: number };
  noindex?: boolean;
  // Blurs the whole shell (header/main/footer) for a password-protected
  // gallery's `__locked` preview — pair with a `slot="overlay"` child (kept
  // outside .shell, so it stays sharp) for the password card. See
  // [...gallery].astro and worker/gallery-auth.ts.
  locked?: boolean;
}

const {
  title,
  description = 'Photography by Ryan Taylor, based in Denver, CO.',
  heroReveal = false,
  image,
  noindex = false,
  locked = false,
} = Astro.props;
const fullTitle = title ? `${title} — Ryan Taylor` : 'Ryan Taylor — Denver Photography';
const path = Astro.url.pathname;
const pageUrl = new URL(path, Astro.site);

const fallbackCover = listedGalleries[0] ? photoById(listedGalleries[0].cover) : undefined;
const resolvedImage = image ?? (fallbackCover ? ogImage(fallbackCover) : undefined);
const absoluteImage = resolvedImage ? new URL(resolvedImage.url, Astro.site) : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ryan Taylor',
  url: Astro.site?.toString(),
  description: 'Hobbyist photographer based in Denver, CO.',
  jobTitle: 'Photographer',
  ...(absoluteImage ? { image: absoluteImage.toString() } : {}),
};
const nav = [
  { href: '/', label: 'Work' },
  { href: '/about/', label: 'About' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Ryan Taylor" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {
      absoluteImage && resolvedImage && (
        <>
          <meta property="og:image" content={absoluteImage} />
          <meta property="og:image:width" content={String(resolvedImage.width)} />
          <meta property="og:image:height" content={String(resolvedImage.height)} />
          <meta name="twitter:image" content={absoluteImage} />
        </>
      )
    }
    <link rel="canonical" href={pageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href={IMG_BASE} crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Newsreader:opsz,wght@6..72,300;6..72,400&display=swap"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="shell" class:list={{ 'is-locked': locked }}>
      <header id="site-header" class:list={['site-header', { 'site-header--hero': heroReveal }]}>
        <a class="wordmark" href="/">Ryan Taylor</a>
        <nav class="site-nav">
          {
            nav.map(({ href, label }) => (
              <a href={href} aria-current={(href === '/' ? path === href : path.startsWith(href)) ? 'page' : undefined}>
                {label}
              </a>
            ))
          }
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <span>© {new Date().getFullYear()} Ryan Taylor</span>
        <div class="site-footer-links">
          <a href="/terms/">Terms & Conditions</a>
          <a href="mailto:contact@ryantaylor.photos">contact@ryantaylor.photos</a>
          <a class="site-footer-gear" href="/utils/" aria-label="Utilities" title="Utilities">
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
              <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                <circle cx="12" cy="12" r="3.4" />
                {[0, 45, 90, 135, 180, 225, 270, 315].map((deg) => (
                  <line x1="12" y1="1.6" x2="12" y2="4.6" transform={`rotate(${deg} 12 12)`} />
                ))}
              </g>
            </svg>
          </a>
        </div>
      </footer>
    </div>

    <slot name="overlay" />

    {
      heroReveal && (
        <script>
          const header = document.getElementById('site-header')!;
          const heroName = document.getElementById('hero-name');
          if (heroName) {
            let observer: IntersectionObserver;
            const setup = () => {
              observer?.disconnect();
              observer = new IntersectionObserver(
                ([entry]) => header.classList.toggle('is-scrolled', !entry.isIntersecting),
                { rootMargin: `-${header.getBoundingClientRect().height}px 0px 0px 0px`, threshold: 0 },
              );
              observer.observe(heroName);
            };
            setup();
            window.addEventListener('resize', setup);
          }
        </script>
      )
    }
  </body>
</html>
